  }

  .stage-checkbox:has(input:disabled:not(:checked)) {
    cursor: default;
  }

  .stage-label,
  .stage-result {
    color: var(--sage-strong);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
