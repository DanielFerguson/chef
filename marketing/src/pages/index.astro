---
import FaqList from '../components/FaqList.astro';
import MarketingFooter from '../components/MarketingFooter.astro';
import MarketingHeader from '../components/MarketingHeader.astro';
import PricingOffer from '../components/PricingOffer.astro';
import { faqs, site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const appUrl =
  import.meta.env.PUBLIC_APP_URL ?? 'https://app.chef.example/start';
const siteUrl = Astro.site?.toString() ?? 'https://chef.example/';

const mealPlan = [
  ['MON 20', 'Spinach & lemon chicken', '4 people · 30m', ''],
  ['TUE 21', 'Tomato gnocchi', '2 people · 25m', 'oat'],
  ['WED 22', 'Leftover lemon chicken', '4 people · 10m', ''],
  ['THU 23', 'Quick beef rice bowls', '4 people · 20m', 'sage'],
  ['FRI 24', 'Takeaway night', 'Open choice', ''],
] as const;

const stages = [
  {
    number: '01',
    label: 'Plan',
    title: 'Plan once for the week',
    body: 'Tell Chef who is home, what sounds good, what needs using, and which nights need to be easy.',
    result: 'Creates → a draft meal plan',
  },
  {
    number: '02',
    label: 'Review',
    title: 'Keep everyone aligned',
    body: 'Move meals, change servings, and let the household review one shared week.',
    result: 'Creates → an agreed week',
  },
  {
    number: '03',
    label: 'Shop',
    title: 'Build the list',
    body: 'Chef combines ingredients, adjusts quantities, and keeps every source visible.',
    result: 'Creates → a trusted list',
  },
  {
    number: '04',
    label: 'Trolley',
    title: 'Let Chef fill the trolley',
    body: 'Chef adds matched products and household essentials in your Woolworths or Coles account.',
    result: 'Creates → a trolley to review',
  },
  {
    number: '05',
    label: 'Cook',
    title: 'Use it tonight',
    body: 'Open tonight’s meal, keep useful changes, and make next week easier.',
    result: 'Creates → household learning',
  },
] as const;

const structuredData = [
  {
    '@type': 'Organization',
    '@id': `${siteUrl}#organization`,
    name: site.name,
    url: siteUrl,
    logo: new URL('/brand/chef-mark.svg', siteUrl).toString(),
    description: site.shortDescription,
    areaServed: { '@type': 'Country', name: site.country },
  },
  {
    '@type': 'WebSite',
    '@id': `${siteUrl}#website`,
    url: siteUrl,
    name: site.name,
    description: site.description,
    inLanguage: site.language,
    publisher: { '@id': `${siteUrl}#organization` },
  },
  {
    '@type': 'SoftwareApplication',
    '@id': `${siteUrl}#application`,
    name: site.name,
    applicationCategory: 'LifestyleApplication',
    operatingSystem: 'Web',
    description: site.description,
    inLanguage: site.language,
    audience: {
      '@type': 'Audience',
      audienceType: 'Australian households',
    },
    offers: [
      {
        '@type': 'Offer',
        name: 'Chef Household annual subscription',
        price: site.annualPrice,
        priceCurrency: site.currency,
        url: new URL('/#pricing', siteUrl).toString(),
      },
      {
        '@type': 'Offer',
        name: 'Chef Household monthly subscription',
        price: site.monthlyPrice,
        priceCurrency: site.currency,
        url: new URL('/#pricing', siteUrl).toString(),
      },
    ],
  },
  {
    '@type': 'FAQPage',
    '@id': `${siteUrl}#faq`,
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];
---

<BaseLayout structuredData={structuredData}>
  <MarketingHeader />

  <main id="main-content">
    <section class="hero" id="meal-planning" aria-labelledby="hero-title">
      <div class="page-shell hero-grid">
        <div class="hero-copy" data-reveal>
          <p class="eyebrow eyebrow-dot">Meal planning for real households</p>
          <h1 id="hero-title">
            Plan the week once. Let Chef prepare the trolley.
          </h1>
          <p class="hero-lead">
            Tell Chef who’s eating, what everyone likes, and how the week looks.
            Chef turns it into a shared meal plan, shopping list, and a
            ready-to-review Woolworths or Coles trolley—while checkout stays
            yours.
          </p>
          <p class="time-promise">
            The goal: your week planned and trolley ready to review in one
            focused 5–10 minute session.
          </p>
          <div class="hero-actions">
            <div>
              <a class="button" href={appUrl}>Start your first plan</a>
              <small>14 days free · No card required</small>
            </div>
            <a class="text-link" href="#how-it-works"
              >See how Chef works <span aria-hidden="true">→</span></a
            >
          </div>
        </div>

        <div
          class="plan-demo"
          aria-label="Example plan created from a household conversation"
          data-reveal
        >
          <header>
            <span><i></i>Winter weeknight plan</span>
            <small>Mon 20 – Sun 26 Jul</small>
          </header>
          <div class="plan-demo-body">
            <p class="request-bubble">
              Plan five dinners for four. Tuesday is only two of us, Mia won’t
              eat mushrooms, Thursday needs to be quick, and use the spinach
              first.
            </p>
            <div class="plan-summary">
              <strong><i></i>5 dinners shaped from your week</strong>
              <span>
                <span class="desktop-label">Review before confirming</span>
                <span class="mobile-label">Review</span>
              </span>
            </div>
            <div class="meal-list">
              {
                mealPlan.map(([day, meal, meta, tone]) => (
                  <div
                    class:list={['meal-row', tone && `meal-row--${tone}`]}
                    data-plan-row
                  >
                    <span>{day}</span>
                    <strong>{meal}</strong>
                    <small>{meta}</small>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <div class="page-shell trust-line" aria-label="Chef product principles">
        <span>One shared plan for the household</span>
        <span>Allergies stay explicit and editable</span>
        <span>Checkout stays yours at every shop</span>
      </div>
    </section>

    <section class="problem-section" aria-labelledby="problem-title">
      <div class="page-shell problem-grid">
        <div class="problem-copy" data-reveal>
          <div>
            <p class="eyebrow">The weekly reality</p>
            <h2 id="problem-title">Stop rebuilding the week in your head.</h2>
          </div>
          <p class="problem-desktop">
            Chef keeps the schedules, serving counts, preferences, leftovers,
            recipes, and shopping decisions together—so the household does not
            have to start again every night.
          </p>
          <p class="problem-mobile">
            Most meal planners start with recipes. Chef starts with your
            household and the week you actually have.
          </p>
        </div>

        <div
          class="decision-flow"
          aria-label="Scattered decisions become one shared plan"
          data-reveal
        >
          <div>
            <span>01</span><strong>Messages and passing comments</strong><small
              >“Mia said no”</small
            >
          </div>
          <div>
            <span>02</span><strong>Calendar and shifting schedules</strong
            ><small>“Late Thursday”</small>
          </div>
          <div>
            <span>03</span><strong>Recipes, pantry and leftovers</strong><small
              >“Use spinach”</small
            >
          </div>
          <div>
            <span>04</span><strong>Supermarket list and budget</strong><small
              >“Under $180”</small
            >
          </div>
          <div class="decision-result">
            <img src="/brand/chef-mark.svg" alt="" width="30" height="30" />
            <strong>One shared plan the household can use</strong>
            <small>Conversation → structure</small>
          </div>
        </div>
      </div>
    </section>

    <section
      class="how-section section-pad"
      id="how-it-works"
      aria-labelledby="how-title"
    >
      <div class="page-shell">
        <header class="how-heading" data-reveal>
          <div>
            <p class="eyebrow">From decision to dinner</p>
            <h2 id="how-title">
              One conversation. One plan. The rest of the week connected.
            </h2>
          </div>
          <p>
            Most meal planners start with recipes. Chef starts with your
            household—and carries those decisions into the shopping list.
          </p>
        </header>

        <div class="stage-sequence" data-stage-sequence>
          <span class="stage-progress" data-stage-progress aria-hidden="true"
          ></span>
          <ol class="stage-list" data-stage-list data-active-step="0">
            {
              stages.map((stage, index) => (
                <li data-stage-index={index} data-reveal>
                  <div>
                    <p class="stage-label">
                      {stage.number} / {stage.label}
                    </p>
                    <h3>{stage.title}</h3>
                    <p>{stage.body}</p>
                  </div>
                  <small>{stage.result}</small>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    <section
      class="memory-section section-pad section-surface"
      id="household-memory"
      aria-labelledby="memory-title"
    >
      <div class="page-shell narrative-grid narrative-grid--proof-first">
        <article
          class="truth-card"
          aria-label="Inspectable household memory example"
          data-reveal
        >
          <header>
            <span class="avatar">M</span>
            <span
              ><strong>Mia</strong><small
                >Meal participant · no account needed</small
              ></span
            >
            <em>3 visible truths</em>
          </header>
          <div class="truth-row">
            <span>Preference</span>
            <div>
              <strong>Dislikes mushrooms</strong><small
                >Mia said “I don’t like mushrooms” · 18 Jul</small
              >
            </div>
          </div>
          <div class="truth-row">
            <span>This week</span>
            <div>
              <strong>Eating Monday, Wednesday and Thursday</strong><small
                >Tuesday’s plan remains for two people</small
              >
            </div>
          </div>
          <div class="safety-note">
            <i></i>
            <div>
              <strong>Not treated as an allergy</strong><small
                >Chef only records safety constraints from an explicit household
                statement.</small
              >
            </div>
          </div>
        </article>

        <div class="narrative-copy" data-reveal>
          <p class="eyebrow">Personalisation you can inspect</p>
          <h2 id="memory-title">
            Recommendations that fit your household—not a generic family.
          </h2>
          <p>
            Chef remembers who is eating, which meals work, what people
            genuinely dislike, and which nights need to be easy. Everything it
            remembers stays visible and editable.
          </p>
          <a class="text-link" href="/household-memory"
            >Explore household memory <span aria-hidden="true">→</span></a
          >
        </div>
      </div>
    </section>

    <section
      class="shopping-section section-pad"
      id="shopping"
      aria-labelledby="shopping-title"
    >
      <div class="page-shell narrative-grid">
        <div class="narrative-copy" data-reveal>
          <p class="eyebrow">The decision carries through</p>
          <h2 id="shopping-title">Agree on dinner. Get the list.</h2>
          <p>
            Chef combines the meals you chose, adjusts quantities for the people
            eating, keeps pantry decisions visible, and shows where every
            generated item came from.
          </p>
          <p class="included-note">
            Included with Chef Household: unlimited meal plans, recipes,
            shopping lists, and members of your household.
          </p>
        </div>

        <article
          class="shopping-card"
          aria-label="Shopping list items with their sources"
          data-reveal
        >
          <header>
            <span
              ><small>Winter weeknight plan</small><strong
                >18 items to review</strong
              ></span
            >
            <small>Revision 4 · current</small>
          </header>
          <div class="shopping-row">
            <span class="checkbox checkbox--sage"></span>
            <div>
              <strong>Baby spinach · 240 g</strong><small
                >Spinach & lemon chicken + tomato gnocchi</small
              >
            </div>
            <em>2 meal sources</em>
          </div>
          <div class="shopping-row">
            <span class="checkbox"></span>
            <div>
              <strong>Chicken breast · 800 g</strong><small
                >Scaled from 4 recipe servings to 4 planned servings</small
              >
            </div>
            <em>1 meal source</em>
          </div>
          <div class="shopping-row shopping-row--oat">
            <span class="checkbox checkbox--oat"></span>
            <div>
              <strong>Milk · 2 L</strong><small
                >Household staple · added manually</small
              >
            </div>
            <em>Staple</em>
          </div>
          <footer>
            <span>Every generated quantity keeps its source.</span>
            <a href="/shopping">Open shopping list →</a>
          </footer>
        </article>
      </div>
    </section>

    <section
      class="trolley-section section-pad section-surface"
      id="trolley"
      aria-labelledby="trolley-title"
    >
      <div class="page-shell narrative-grid narrative-grid--trolley">
        <div class="narrative-copy" data-reveal>
          <p class="eyebrow">From plan to checkout</p>
          <h2 id="trolley-title">
            Your trolley, prepared in the account you already use.
          </h2>
          <p>
            Chef’s Chrome extension adds the planned ingredients and the rest of
            your groceries to Woolworths or Coles. Because it works in your
            account, your saved products, points, rewards, and delivery options
            stay with you.
          </p>
          <p class="included-note">
            Chef prepares and reconciles the trolley. You review it, choose
            delivery or collection, and click checkout.
          </p>
          <p class="device-note">
            The same plan and recipes stay ready on your laptop and phone when
            it is time to cook.
          </p>
        </div>

        <article
          class="trolley-card"
          aria-label="Example grocery trolley preparation"
          data-reveal
        >
          <header>
            <span>
              <small>Chef Chrome extension</small>
              <strong>Preparing your weekly trolley</strong>
            </span>
            <em>Ready for review</em>
          </header>

          <div class="retailer-choice" aria-label="Supported retailers">
            <span>Woolworths</span>
            <span>Coles</span>
          </div>

          <div class="trolley-progress">
            <div>
              <i>✓</i><span
                ><strong>18 meal ingredients matched</strong><small
                  >Quantities checked against the plan</small
                ></span
              >
            </div>
            <div>
              <i>✓</i><span
                ><strong>6 household essentials added</strong><small
                  >Milk, fruit, breakfast, and cleaning items</small
                ></span
              >
            </div>
            <div class="trolley-progress--review">
              <i>1</i><span
                ><strong>One substitution needs you</strong><small
                  >Review before Chef finishes the trolley</small
                ></span
              >
            </div>
          </div>

          <footer>
            <span>Your retailer account keeps its points and rewards.</span>
            <strong>Review trolley → Checkout yourself</strong>
          </footer>
        </article>
      </div>
    </section>

    <PricingOffer />
    <FaqList />

    <section
      class="final-cta section-surface"
      aria-labelledby="final-cta-title"
    >
      <div class="page-shell" data-reveal>
        <p class="eyebrow">One conversation carries through the week</p>
        <h2 id="final-cta-title">
          Plan it. Prepare the trolley. Cook from the same shared week.
        </h2>
        <p>
          Tell Chef who’s eating and what is different this week. Review the
          plan and trolley, then keep every meal and recipe at your fingertips
          on laptop or phone.
        </p>
        <a class="button" href={appUrl}>Start your first plan</a>
        <small>14 days free · No card required</small>
      </div>
    </section>
  </main>

  <MarketingFooter />
</BaseLayout>

<style>
  .hero {
    background: var(--canvas);
    padding: 4.625rem 0 4rem;
  }

  .hero-grid {
    align-items: start;
    display: grid;
    gap: 4rem;
    grid-template-columns: minmax(25rem, 33.125rem) minmax(32rem, 40.625rem);
    justify-content: space-between;
  }

  .eyebrow-dot {
    align-items: center;
    display: flex;
    gap: 0.55rem;
  }

  .eyebrow-dot::before,
  .plan-demo header i,
  .plan-summary i {
    background: var(--sage);
    border-radius: 50%;
    content: '';
    display: inline-block;
    height: 0.5rem;
    width: 0.5rem;
  }

  .hero-copy h1 {
    font-family: var(--font-editorial);
    font-size: clamp(3.5rem, 5.4vw, 4.25rem);
    line-height: 1.03;
    margin-top: 1.5rem;
  }

  .hero-lead {
    color: var(--muted);
    font-size: 1.1875rem;
    line-height: 1.52;
    margin-top: 1.55rem;
    max-width: 31rem;
  }

  .time-promise {
    border-left: 3px solid var(--sage);
    color: var(--sage-strong);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.45;
    margin-top: 1.25rem;
    max-width: 31rem;
    padding-left: 0.875rem;
  }

  .hero-actions {
    align-items: center;
    display: flex;
    gap: 1.5rem;
    margin-top: 1.875rem;
  }

  .hero-actions > div {
    align-items: start;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hero-actions small {
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .plan-demo {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .plan-demo > header {
    align-items: center;
    background: var(--canvas);
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    min-height: 3.625rem;
    padding-inline: 1.25rem;
  }

  .plan-demo > header span,
  .plan-summary strong {
    align-items: center;
    display: flex;
    font-size: 0.875rem;
    font-weight: 600;
    gap: 0.55rem;
  }

  .plan-demo > header i {
    background: var(--paprika);
  }

  .plan-demo > header small,
  .plan-summary span {
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .mobile-label,
  .problem-mobile {
    display: none;
  }

  .plan-demo-body {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    padding: 1.25rem;
  }

  .request-bubble {
    align-self: end;
    background: var(--ink);
    border-radius: 1rem 1rem 0.25rem 1rem;
    color: #fff;
    font-size: 0.875rem;
    line-height: 1.5;
    max-width: 29.375rem;
    padding: 0.875rem 1rem;
  }

  .plan-summary {
    align-items: center;
    display: flex;
    justify-content: space-between;
    padding-inline: 0.125rem;
  }

  .plan-summary strong {
    color: var(--sage-strong);
    font-size: 0.8125rem;
  }

  .meal-list {
    background: var(--canvas);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .meal-row {
    align-items: center;
    border-bottom: 1px solid var(--border);
    display: grid;
    gap: 0.5rem;
    grid-template-columns: 4rem 1fr 5.75rem;
    min-height: 3.25rem;
    padding-inline: 0.875rem;
  }

  .meal-row:last-child {
    border-bottom: 0;
  }

  .meal-row--oat {
    background: rgb(220 207 185 / 28%);
  }

  .meal-row--sage {
    background: rgb(111 128 106 / 8%);
  }

  .meal-row span,
  .meal-row small {
    color: var(--muted);
    font-size: 0.75rem;
  }

  .meal-row strong {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .meal-row small {
    color: var(--sage-strong);
    text-align: right;
  }

  .trust-line {
    border-top: 1px solid var(--border);
    display: flex;
    font-size: 0.875rem;
    justify-content: space-between;
    margin-top: 2.625rem;
    padding-top: 1.375rem;
  }

  .trust-line span:first-child {
    color: var(--muted);
  }

  .problem-section {
    background: var(--ink);
    color: #fff;
    padding-block: 5.75rem;
  }

  .problem-grid {
    display: grid;
    gap: 6rem;
    grid-template-columns: minmax(26rem, 35rem) minmax(32rem, 1fr);
  }

  .problem-copy {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .problem-copy .eyebrow {
    color: var(--oat);
  }

  .problem-copy h2 {
    color: #fff;
    font-size: clamp(2.8rem, 4vw, 3.125rem);
    line-height: 1.08;
    margin-top: 1.5rem;
  }

  .problem-copy > p {
    color: #c9c8c5;
    font-size: 1.125rem;
    line-height: 1.55;
    max-width: 31rem;
  }

  .decision-flow {
    border-bottom: 1px solid #55534d;
    border-top: 1px solid #55534d;
  }

  .decision-flow > div {
    align-items: center;
    border-bottom: 1px solid #45443f;
    display: grid;
    gap: 0.5rem;
    grid-template-columns: 2.375rem 1fr 6.875rem;
    min-height: 4.2rem;
  }

  .decision-flow span {
    color: var(--oat);
    font-size: 0.8125rem;
  }

  .decision-flow strong {
    font-size: 1.0625rem;
    font-weight: 400;
  }

  .decision-flow small {
    color: #9e9c96;
    font-size: 0.8125rem;
    text-align: right;
  }

  .decision-flow .decision-result {
    background: var(--paprika);
    border: 0;
    border-radius: var(--radius-sm);
    grid-template-columns: 2rem 1fr auto;
    margin-top: -1px;
    min-height: 5.125rem;
    padding-inline: 1.125rem;
  }

  .decision-result img {
    filter: brightness(0) invert(1);
  }

  .decision-result strong {
    font-size: 1.1875rem;
    font-weight: 600;
  }

  .decision-result small {
    color: #fbe7e1;
  }

  .how-heading {
    align-items: end;
    display: flex;
    justify-content: space-between;
  }

  .how-heading > div {
    max-width: 44.5rem;
  }

  .how-heading h2,
  .narrative-copy h2 {
    font-size: clamp(2.75rem, 4vw, 3rem);
    line-height: 1.08;
    margin-top: 1.125rem;
  }

  .how-heading > p {
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.6;
    max-width: 22.5rem;
  }

  .stage-sequence {
    border-top: 1px solid var(--border);
    margin-top: 4rem;
    position: relative;
  }

  .stage-progress {
    background: var(--paprika);
    height: 4px;
    left: 0;
    position: absolute;
    top: -1px;
    transform: scaleX(0.28);
    transform-origin: left center;
    width: 100%;
    z-index: 2;
  }

  .stage-list {
    border-bottom: 1px solid var(--border);
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr 1fr;
    list-style: none;
    margin: 0;
    padding: 0;
    transition: grid-template-columns 650ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .stage-list[data-active-step='1'] {
    grid-template-columns: 1fr 1.5fr 1fr 1fr 1fr;
  }

