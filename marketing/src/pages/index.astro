  }

  .stage-progress {
    background: var(--paprika);
    height: 4px;
    left: 0;
    position: absolute;
    top: -1px;
    transform: scaleX(0);
    transform-origin: left center;
    width: 100%;
    z-index: 2;
  }

  .stage-list {
    border-bottom: 1px solid var(--border);
    display: grid;
    grid-template-columns: 1.55fr 1fr 1fr 1fr;
    list-style: none;
    margin: 0;
    padding: 0;
    transition: grid-template-columns 650ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .stage-list[data-active-step='1'] {
    grid-template-columns: 1fr 1.55fr 1fr 1fr;
  }

  .stage-list[data-active-step='2'] {
    grid-template-columns: 1fr 1fr 1.55fr 1fr;
  }

  .stage-list[data-active-step='3'] {
    grid-template-columns: 1fr 1fr 1fr 1.55fr;
  }

  .stage-list li {
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 21.25rem;
    padding: 2.125rem 1.75rem 1.75rem;
    transition:
      background-color 400ms ease,
      padding 650ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .stage-list li[data-stage-state='upcoming'] {
    background: #fafaf8;
  }

  .stage-list li:last-child {
    border-right: 0;
  }

  .stage-list[data-active-step='0'] li:first-child {
    padding-left: 0;
    padding-right: 2.125rem;
  }

  .stage-card-header {
    align-items: center;
    display: flex;
    gap: 0.65rem;
  }

  .stage-checkbox {
    cursor: pointer;
    display: inline-flex;
    flex: none;
    position: relative;
  }

  .stage-checkbox input {
    height: 1px;
    opacity: 0;
    position: absolute;
    width: 1px;
  }

  .stage-checkbox > span {
    align-items: center;
    background: var(--canvas);
    border: 1px solid #cbc9c1;
    border-radius: 0.35rem;
    display: inline-flex;
    height: 1.5rem;
    justify-content: center;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
    width: 1.5rem;
  }

  .stage-checkbox path {
    fill: none;
    stroke: #fff;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
    transition: stroke-dashoffset 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .stage-checkbox input:focus-visible + span {
    outline: 3px solid color-mix(in srgb, var(--paprika) 34%, transparent);
    outline-offset: 3px;
  }

  .stage-checkbox input:checked + span {
    background: var(--paprika);
    border-color: var(--paprika);
  }

  .stage-checkbox input:checked + span path {
    stroke-dashoffset: 0;
  }

  .stage-checkbox input:disabled:not(:checked) + span {
    background: #f1f0eb;
    border-color: #dfddd6;
    opacity: 0.6;
  }

  .stage-list
    li:first-child
    .stage-checkbox
    input:not(:checked):not(:disabled)
    + span {
    animation: stage-checkbox-pulse 1.8s ease-out infinite;
    border-color: var(--paprika);
  }

  @keyframes stage-checkbox-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgb(201 79 50 / 0%);
      transform: scale(1);
    }

    38% {
      box-shadow: 0 0 0 0.55rem rgb(201 79 50 / 13%);
      transform: scale(1.05);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage-list
      li:first-child
      .stage-checkbox
      input:not(:checked):not(:disabled)
      + span {
      animation: none;
      box-shadow: 0 0 0 3px rgb(201 79 50 / 12%);
