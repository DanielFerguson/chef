---
import FaqList from '../components/FaqList.astro';
import HeroWorkflow from '../components/HeroWorkflow.astro';
import MarketingFooter from '../components/MarketingFooter.astro';
import MarketingHeader from '../components/MarketingHeader.astro';
import PricingOffer from '../components/PricingOffer.astro';
import { faqs, site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const appUrl =
  import.meta.env.PUBLIC_APP_URL ?? 'https://app.chef.example/start';
const siteUrl = Astro.site?.toString() ?? 'https://chef.example/';

const stages = [
  {
    number: '01',
    label: 'Plan',
    title: 'Plan the week',
    body: 'Tell Chef who is home, what sounds good, what needs using, and which nights need to be easy.',
    result: 'Draft meal plan ready',
  },
  {
    number: '02',
    label: 'Shop',
    title: 'Build the list',
    body: 'Chef combines ingredients, adjusts quantities, and keeps every source visible.',
    result: 'Shopping list ready',
  },
  {
    number: '03',
    label: 'Order',
    title: 'Prepare the trolley',
    body: 'Chef adds matched products and household essentials in your Woolworths or Coles account.',
    result: 'Trolley ready to review',
  },
  {
    number: '04',
    label: 'Tonight',
    title: 'Use it tonight',
    body: 'Open tonight’s meal, keep useful changes, and make next week easier.',
    result: 'Dinner at your fingertips',
  },
] as const;

const shoppingItems = [
  {
    name: 'Baby spinach · 240 g',
    source: 'Spinach & lemon chicken + tomato gnocchi',
    meta: '2 meal sources',
    tone: 'sage',
  },
  {
    name: 'Chicken breast · 800 g',
    source: 'Scaled from 4 recipe servings to 4 planned servings',
    meta: '1 meal source',
    tone: '',
  },
  {
    name: 'Milk · 2 L',
    source: 'Household staple · added manually',
    meta: 'Staple',
    tone: 'oat',
  },
  {
    name: 'Potato gnocchi · 500 g',
    source: 'Tomato gnocchi · Tuesday for two',
    meta: '1 meal source',
    tone: '',
  },
  {
    name: 'Lemons · 3',
    source: 'Chicken dinner + pantry dressing',
    meta: '2 meal sources',
    tone: '',
  },
  {
    name: 'Jasmine rice · 400 g',
    source: 'Quick beef rice bowls · Thursday',
    meta: '1 meal source',
    tone: '',
  },
] as const;

const structuredData = [
  {
    '@type': 'Organization',
    '@id': `${siteUrl}#organization`,
    name: site.name,
    url: siteUrl,
    logo: new URL('/brand/chef-mark.svg', siteUrl).toString(),
    description: site.shortDescription,
    areaServed: { '@type': 'Country', name: site.country },
  },
  {
    '@type': 'WebSite',
    '@id': `${siteUrl}#website`,
    url: siteUrl,
    name: site.name,
    description: site.description,
    inLanguage: site.language,
    publisher: { '@id': `${siteUrl}#organization` },
  },
  {
    '@type': 'SoftwareApplication',
    '@id': `${siteUrl}#application`,
    name: site.name,
    applicationCategory: 'LifestyleApplication',
    operatingSystem: 'Web',
    description: site.description,
    inLanguage: site.language,
    audience: {
      '@type': 'Audience',
      audienceType: 'Australian households',
    },
    offers: [
      {
        '@type': 'Offer',
        name: 'Chef Household annual subscription',
        price: site.annualPrice,
        priceCurrency: site.currency,
        url: new URL('/#pricing', siteUrl).toString(),
      },
      {
        '@type': 'Offer',
        name: 'Chef Household monthly subscription',
        price: site.monthlyPrice,
        priceCurrency: site.currency,
        url: new URL('/#pricing', siteUrl).toString(),
      },
    ],
  },
  {
    '@type': 'FAQPage',
    '@id': `${siteUrl}#faq`,
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];
---

<BaseLayout structuredData={structuredData}>
  <MarketingHeader />

  <main id="main-content">
    <section class="hero" id="meal-planning" aria-labelledby="hero-title">
      <div class="page-shell hero-grid">
        <div class="hero-copy" data-reveal>
          <h1 id="hero-title">
            Plan the week once. Let Chef carry it through to dinner.
          </h1>
          <p class="hero-lead">
            One focused 5–10 minute conversation becomes a shared meal plan,
            shopping list, and ready-to-review trolley—with every recipe ready
            when it’s time to cook.
          </p>
          <div class="hero-actions">
            <div>
              <a class="button" href={appUrl}>Start your first plan</a>
              <small>14 days free · No card required</small>
            </div>
            <a class="text-link" href="#how-it-works"
              >See how Chef works <span aria-hidden="true">→</span></a
            >
          </div>
        </div>

        <HeroWorkflow />
      </div>
    </section>

    <section class="problem-section" aria-labelledby="problem-title">
      <div class="page-shell problem-grid">
        <div class="problem-copy" data-reveal>
          <div>
            <p class="eyebrow">The weekly reality</p>
            <h2 id="problem-title">Stop rebuilding the week in your head.</h2>
          </div>
          <p class="problem-desktop">
            Chef keeps the schedules, serving counts, preferences, leftovers,
            recipes, and shopping decisions together—so the household does not
            have to start again every night.
          </p>
          <p class="problem-mobile">
            Most meal planners start with recipes. Chef starts with your
            household and the week you actually have.
          </p>
        </div>

        <div
          class="decision-flow"
          aria-label="Scattered decisions become one shared plan"
          data-reveal
        >
          <div>
            <span>01</span><strong>Messages and passing comments</strong><small
              >“Mia said no”</small
            >
          </div>
          <div>
            <span>02</span><strong>Calendar and shifting schedules</strong
            ><small>“Late Thursday”</small>
          </div>
          <div>
            <span>03</span><strong>Recipes, pantry and leftovers</strong><small
              >“Use spinach”</small
            >
          </div>
          <div>
            <span>04</span><strong>Supermarket list and budget</strong><small
              >“Under $180”</small
            >
          </div>
          <div class="decision-result">
            <span class="decision-check" data-decision-check aria-hidden="true">
              <svg viewBox="0 0 20 20" width="20" height="20">
                <path data-decision-check-path pathLength="1" d="m5 10 3 3 7-7"
                ></path>
              </svg>
            </span>
            <strong>One shared plan the household can use</strong>
            <small>Conversation → structure</small>
          </div>
        </div>
      </div>
    </section>

    <section
      class="how-section section-pad"
      id="how-it-works"
      aria-labelledby="how-title"
    >
      <div class="page-shell">
        <header class="how-heading" data-reveal>
          <div>
            <p class="eyebrow">From decision to dinner</p>
            <h2 id="how-title">Plan it. Shop it. Order it. Use it tonight.</h2>
          </div>
          <p>
            Check off each step to see how one household conversation carries
            through the entire week.
          </p>
        </header>

        <p class="stage-prompt" data-reveal>
          <span class="stage-prompt-badge">Try it</span>
          <span data-stage-prompt>Check Plan to move the week forward.</span>
        </p>

        <div class="stage-sequence" data-stage-sequence>
          <span class="stage-progress" data-stage-progress aria-hidden="true"
          ></span>
          <ol class="stage-list" data-stage-list data-active-step="0">
            {
              stages.map((stage, index) => (
                <li
                  data-stage-index={index}
                  data-stage-name={stage.label}
                  data-stage-state={index === 0 ? 'active' : 'upcoming'}
                  data-reveal
                >
                  <div class="stage-card-header">
                    <label class="stage-checkbox">
                      <input
                        type="checkbox"
                        data-stage-checkbox
                        aria-label={`Complete ${stage.label} step`}
                        disabled={index !== 0}
                      />
                      <span aria-hidden="true">
                        <svg viewBox="0 0 18 18" width="18" height="18">
                          <path pathLength="1" d="m4.5 9 3 3 6-6" />
                        </svg>
                      </span>
                    </label>
                    <p class="stage-label">
                      {stage.number} / {stage.label}
                    </p>
                  </div>
                  <div class="stage-copy">
                    <h3>{stage.title}</h3>
                    <p>{stage.body}</p>
                  </div>
                  <small class="stage-result">Outcome → {stage.result}</small>
                </li>
              ))
            }
          </ol>
          <p class="stage-status sr-only" data-stage-status aria-live="polite">
            Plan is ready to complete.
          </p>
        </div>
      </div>
    </section>

    <section
      class="memory-section section-pad section-surface"
      id="household-memory"
      aria-labelledby="memory-title"
    >
      <div class="page-shell narrative-grid narrative-grid--proof-first">
        <article
          class="truth-card"
          aria-label="How visible household memory shapes a recommendation"
          data-memory-proof
          data-reveal
        >
          <header>
            <span class="avatar">M</span>
            <span
              ><strong>Mia</strong><small
                >Meal participant · no account needed</small
              ></span
            >
            <em>Visible &amp; editable</em>
          </header>

          <div class="memory-truths" aria-label="Household truths used">
            <div class="truth-row" data-memory-truth>
              <span>Preference</span>
              <div>
                <strong>Dislikes mushrooms</strong><small
                  >Mia said “I don’t like mushrooms” · 18 Jul</small
                >
              </div>
              <em>From Mia</em>
            </div>
            <div class="truth-row" data-memory-truth>
              <span>This week</span>
              <div>
                <strong>Eating Monday, Wednesday and Thursday</strong><small
                  >Tuesday’s plan remains for two people</small
                >
              </div>
              <em>Plan-specific</em>
            </div>
            <div class="safety-note" data-memory-truth>
              <i></i>
              <div>
                <strong>Not treated as an allergy</strong><small
                  >Safety constraints only come from an explicit household
                  statement.</small
                >
              </div>
              <em>Safety boundary</em>
            </div>
          </div>

          <div class="memory-connector" data-memory-connector>
            <span></span><small>Chef applies these truths to this week</small
            ><span></span>
          </div>

          <section class="recommendation-proof" data-memory-output>
            <header>
              <span>Thu 23 · Dinner</span><em>Recommended for this household</em
              >
            </header>
            <h3>Quick lemon chicken bowls</h3>
            <p>4 people · 25 minutes</p>
            <ul aria-label="Reasons for this recommendation">
              <li>No mushrooms for Mia</li>
              <li>Quick Thursday</li>
              <li>Uses spinach first</li>
            </ul>
            <footer>
              <span>Why this meal?</span><strong
                >3 household reasons are visible</strong
              >
            </footer>
          </section>
        </article>

        <div class="narrative-copy" data-reveal>
          <p class="eyebrow">Personalisation you can inspect</p>
          <h2 id="memory-title">
            Recommendations that fit your household—not a generic family.
          </h2>
          <p>
            Chef remembers who is eating, which meals work, what people dislike,
            and which nights need to be easy—then shows how those truths shaped
            each recommendation. Everything stays visible and editable.
          </p>
          <a class="text-link" href="/household-memory"
            >Explore household memory <span aria-hidden="true">→</span></a
          >
        </div>
      </div>
    </section>

    <section
      class="shopping-section section-pad"
      id="shopping"
      aria-labelledby="shopping-title"
    >
      <div class="page-shell narrative-grid">
        <div class="narrative-copy" data-reveal>
          <p class="eyebrow">The decision carries through</p>
          <h2 id="shopping-title">Agree on dinner. Get the list.</h2>
          <p>
            Chef combines the meals you chose, adjusts quantities for the people
            eating, keeps pantry decisions visible, and shows where every
            generated item came from.
          </p>
          <p class="included-note">
            <strong>Try the list.</strong> Check off an ingredient or add a household
            extra. Every generated item stays connected to its source.
          </p>
        </div>

        <article
          class="shopping-card"
          aria-label="Shopping list items with their sources"
          data-reveal
        >
          <header>
            <span
              ><small>Winter weeknight plan</small><strong
                ><span data-shopping-total>18</span> items · <span
                  data-shopping-complete>0</span
                > checked</strong
              ></span
            >
            <small>Revision 4 · current</small>
          </header>

          <div
            class="shopping-list"
            data-shopping-list
            aria-label="Interactive shopping list"
          >
            {
              shoppingItems.map((item, index) => (
                <div
                  class:list={[
                    'shopping-row',
                    item.tone && `shopping-row--${item.tone}`,
                  ]}
                  data-shopping-row
                >
                  <input
                    class="shopping-checkbox-input"
                    type="checkbox"
                    id={`shopping-item-${index}`}
                    data-shopping-checkbox
                    aria-label={`Mark ${item.name} complete`}
                  />
                  <label
                    class:list={[
                      'shopping-check',
                      item.tone && `shopping-check--${item.tone}`,
                    ]}
                    for={`shopping-item-${index}`}
                    aria-hidden="true"
                  >
                    <svg viewBox="0 0 18 18" width="18" height="18">
                      <path pathLength="1" d="m4.5 9 3 3 6-6" />
                    </svg>
                  </label>
                  <label
                    class="shopping-item-copy"
                    for={`shopping-item-${index}`}
                  >
                    <>
                      <strong>{item.name}</strong>
                      <small>{item.source}</small>
                    </>
                  </label>
                  <em>{item.meta}</em>
                </div>
              ))
            }
          </div>

          <form class="shopping-add" data-shopping-form>
            <label class="sr-only" for="shopping-extra"
              >Add a household item</label
            >
            <input
              id="shopping-extra"
              name="shopping-extra"
              type="text"
              maxlength="48"
              placeholder="Add a household item, e.g. paper towels"
              autocomplete="off"
              data-shopping-input
            />
            <button type="submit"
              >Add item <span aria-hidden="true">+</span></button
            >
          </form>
          <p class="sr-only" data-shopping-status aria-live="polite"></p>

          <footer>
            <span>Every generated quantity keeps its source.</span>
            <a href="/shopping">Open shopping list →</a>
          </footer>
        </article>
      </div>
    </section>

    <section
      class="trolley-section section-pad section-surface"
      id="trolley"
      aria-labelledby="trolley-title"
    >
      <div class="page-shell narrative-grid narrative-grid--trolley">
        <div class="narrative-copy" data-reveal>
          <p class="eyebrow">From plan to checkout</p>
          <h2 id="trolley-title">
            Your trolley, prepared in the account you already use.
          </h2>
          <p>
            Chef’s Chrome extension adds the planned ingredients and the rest of
            your groceries to Woolworths or Coles. Because it works in your
            account, your saved products, points, rewards, and delivery options
            stay with you.
          </p>
          <p class="included-note">
            Chef prepares and reconciles the trolley. You review it, choose
            delivery or collection, and click checkout.
          </p>
          <p class="device-note">
            The same plan and recipes stay ready on your laptop and phone when
            it is time to cook.
          </p>
        </div>

        <article
          class="trolley-card"
          aria-label="Example grocery trolley preparation"
          data-trolley-demo
          data-reveal
        >
          <header>
            <span>
              <small>Chef Chrome extension</small>
              <strong data-retailer-heading
                >Preparing your Woolworths trolley</strong
              >
            </span>
            <em data-trolley-state>Ready for review</em>
          </header>

          <div
            class="retailer-choice"
            role="group"
            aria-label="Preview trolley retailer"
          >
            <button
              type="button"
              data-retailer-button
              data-retailer="Woolworths"
              aria-pressed="true">Woolworths</button
            >
            <button
              type="button"
              data-retailer-button
              data-retailer="Coles"
              aria-pressed="false">Coles</button
            >
          </div>

          <div class="trolley-progress">
            <div data-trolley-step>
              <i>✓</i><span
                ><strong>18 meal ingredients matched</strong><small
                  >Quantities checked against the plan</small
                ></span
              >
            </div>
            <div data-trolley-step>
              <i>✓</i><span
                ><strong>6 household essentials added</strong><small
                  >Milk, fruit, breakfast, and cleaning items</small
                ></span
              >
            </div>
            <div class="trolley-progress--review" data-trolley-step>
              <button
                class="trolley-review-toggle"
                type="button"
                aria-expanded="false"
                aria-controls="trolley-substitution-detail"
                data-trolley-review-toggle
              >
                <i>1</i><span
                  ><strong>One substitution needs you</strong><small
                    >See why Chef paused</small
                  ></span
                >
                <svg
                  aria-hidden="true"
                  viewBox="0 0 20 20"
                  width="20"
                  height="20"
                >
                  <path d="m6 8 4 4 4-4"></path>
                </svg>
              </button>
              <div
                class="trolley-review-detail"
                id="trolley-substitution-detail"
                data-trolley-review-detail
                hidden
              >
                <span>
                  <small>Preferred product unavailable</small>
                  <strong>Closest match is a different pack size</strong>
                </span>
                <p>
                  Chef paused instead of changing the product automatically. You
                  choose what enters the final trolley.
                </p>
                <div>
                  <em>Review required</em>
                  <em>Checkout stays yours</em>
                </div>
              </div>
            </div>
          </div>

          <footer>
            <span data-retailer-account
              >Your Woolworths account keeps its points and rewards.</span
            >
            <strong>Review trolley → Checkout yourself</strong>
            <span class="sr-only" data-trolley-status aria-live="polite"></span>
          </footer>
        </article>
      </div>
    </section>

    <PricingOffer />
    <FaqList />

    <section
      class="final-cta section-surface"
      aria-labelledby="final-cta-title"
    >
      <div class="page-shell" data-reveal>
        <p class="eyebrow">One conversation carries through the week</p>
        <h2 id="final-cta-title">
          Plan it. Prepare the trolley. Cook from the same shared week.
        </h2>
        <p>
          Tell Chef who’s eating and what is different this week. Review the
          plan and trolley, then keep every meal and recipe at your fingertips
          on laptop or phone.
        </p>
        <a class="button" href={appUrl}>Start your first plan</a>
        <small>14 days free · No card required</small>
      </div>
    </section>
  </main>

  <MarketingFooter />
</BaseLayout>

<style>
  .hero {
    background: var(--canvas);
    padding: 4.625rem 0 4rem;
  }

  .hero-grid {
    align-items: start;
    display: grid;
    gap: 4rem;
    grid-template-columns: minmax(25rem, 33.125rem) minmax(32rem, 40.625rem);
    justify-content: space-between;
  }

  .hero-copy h1 {
    font-family: var(--font-editorial);
    font-size: clamp(3.5rem, 5.4vw, 4.25rem);
    line-height: 1.03;
  }

  .hero-lead {
    color: var(--muted);
    font-size: 1.1875rem;
    line-height: 1.52;
    margin-top: 1.55rem;
    max-width: 31rem;
  }

  .hero-actions {
    align-items: flex-start;
    display: flex;
    gap: 1.5rem;
    margin-top: 1.875rem;
  }

  .hero-actions .text-link {
    min-height: 3.25rem;
  }

  .hero-actions > div {
    align-items: start;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hero-actions small {
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .problem-mobile {
    display: none;
  }

  .problem-section {
    background: var(--ink);
    color: #fff;
    padding-block: 5.75rem;
  }

  .problem-grid {
    display: grid;
    gap: 6rem;
    grid-template-columns: minmax(26rem, 35rem) minmax(32rem, 1fr);
  }

  .problem-copy {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .problem-copy .eyebrow {
    color: var(--oat);
  }

  .problem-copy h2 {
    color: #fff;
    font-size: clamp(2.8rem, 4vw, 3.125rem);
    line-height: 1.08;
    margin-top: 1.5rem;
  }

  .problem-copy > p {
    color: #c9c8c5;
    font-size: 1.125rem;
    line-height: 1.55;
    max-width: 31rem;
  }

  .decision-flow {
    border-top: 1px solid #55534d;
  }

  .decision-flow > div {
    align-items: center;
    border-bottom: 1px solid #45443f;
    display: grid;
    gap: 0.5rem;
    grid-template-columns: 2.375rem 1fr 6.875rem;
    min-height: 4.2rem;
  }

  .decision-flow span {
    color: var(--oat);
    font-size: 0.8125rem;
  }

  .decision-flow strong {
    font-size: 1.0625rem;
    font-weight: 400;
  }

  .decision-flow small {
    color: #9e9c96;
    font-size: 0.8125rem;
    text-align: right;
  }

  .decision-flow .decision-result {
    background: var(--paprika);
    border: 0;
    border-radius: var(--radius-sm);
    grid-template-columns: 2rem 1fr auto;
    margin-top: 0;
    min-height: 5.125rem;
    padding-inline: 1.125rem;
  }

  .decision-flow > div:nth-last-child(2) {
    border-bottom: 0;
  }

  .decision-flow .decision-check {
    align-items: center;
    background: transparent;
    border: 1.5px solid rgb(255 255 255 / 80%);
    border-radius: 0.35rem;
    display: inline-flex;
    height: 1.75rem;
    justify-content: center;
    width: 1.75rem;
  }

  .decision-check path {
    fill: none;
    stroke: var(--paprika);
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.25;
    transition: stroke-dashoffset 350ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .decision-check.is-checked path {
    stroke-dashoffset: 0;
  }

  .decision-result strong {
    font-size: 1.0625rem;
    font-weight: 400;
  }

  .decision-result small {
    color: #fbe7e1;
  }

  @media (prefers-reduced-motion: reduce) {
    .decision-flow .decision-check {
      background: #fff;
    }

    .decision-check path {
      stroke-dashoffset: 0;
    }
  }

  .how-heading {
    align-items: end;
    display: flex;
    justify-content: space-between;
  }

  .how-heading > div {
    max-width: 44.5rem;
  }

  .how-heading h2,
  .narrative-copy h2 {
    font-size: clamp(2.75rem, 4vw, 3rem);
    line-height: 1.08;
    margin-top: 1.125rem;
  }

  .how-heading > p {
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.6;
    max-width: 22.5rem;
  }

  .stage-prompt {
