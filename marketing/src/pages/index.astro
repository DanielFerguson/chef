    opacity: 0.55;
  }

  .stage-list h3 {
    font-size: 1.6rem;
    line-height: 1.18;
    transition: font-size 650ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .stage-list li[data-stage-state='active'] h3 {
    font-size: 1.875rem;
  }

  .stage-copy {
    margin-top: 1.125rem;
  }

  .stage-copy > p {
