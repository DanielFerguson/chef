  .stage-list li[data-stage-state='active'] .stage-label {
    color: var(--paprika);
  }

  .stage-list li[data-stage-state='upcoming'] .stage-label,
  .stage-list li[data-stage-state='upcoming'] h3,
  .stage-list li[data-stage-state='upcoming'] .stage-copy > p,
