---
interface Props {
  inverted?: boolean;
  compact?: boolean;
}

const { inverted = false, compact = false } = Astro.props;
---

<a
  class:list={[
    'brand',
    { 'brand--inverted': inverted, 'brand--compact': compact },
  ]}
  href="/"
  aria-label="Chef home"
>
  <img
    src="/brand/chef-mark.svg"
    alt=""
    width={compact ? 30 : 34}
    height={compact ? 30 : 34}
  />
  <span>Chef</span>
</a>

<style>
  .brand {
    align-items: center;
    color: var(--ink);
    display: inline-flex;
    flex: none;
    font-family: var(--font-editorial);
    font-size: 1.55rem;
    font-weight: 500;
    gap: 0.75rem;
    letter-spacing: -0.025em;
    line-height: 1;
    text-decoration: none;
  }

  .brand img {
    display: block;
    height: 2.125rem;
    width: 2.125rem;
  }

  .brand--compact {
    font-size: 1.3rem;
    gap: 0.625rem;
  }

  .brand--compact img {
    height: 1.875rem;
    width: 1.875rem;
  }

  .brand--inverted {
    color: #fff;
  }
</style>
