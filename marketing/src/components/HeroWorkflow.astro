---
const stages = [
  { label: 'Plan', title: 'Plan the week' },
  { label: 'Meals', title: 'Set the meals' },
  { label: 'Trolley', title: 'Prepare the trolley' },
  { label: 'Tonight', title: 'Cook tonight' },
] as const;

const meals = [
  ['MON 20', 'Spinach & lemon chicken', '4 people · 30m', ''],
  ['TUE 21', 'Tomato gnocchi', '2 people · 25m', 'oat'],
  ['WED 22', 'Leftover lemon chicken', '4 people · 10m', ''],
  ['THU 23', 'Quick beef rice bowls', '4 people · 20m', 'sage'],
  ['FRI 24', 'Takeaway night', 'Open choice', ''],
] as const;
---

<article
  class="hero-workflow"
  aria-label="One household plan moving from conversation to tonight’s dinner"
  data-hero-workflow
  data-reveal
>
  <header class="workflow-header">
    <div class="workflow-identity">
      <i aria-hidden="true"></i>
      <span>
        <small>Winter weeknight plan</small>
        <strong data-workflow-current-label>Plan the week</strong>
      </span>
    </div>
    <button
      class="workflow-playback"
      type="button"
      data-workflow-playback
      aria-label="Pause workflow animation"
    >
      Pause
    </button>
  </header>

  <div class="workflow-stage-controls" aria-label="Workflow stages">
    {
      stages.map((stage, index) => (
        <button
          id={`workflow-stage-${index}`}
          type="button"
          data-workflow-control
          data-stage-index={index}
          data-stage-label={stage.label}
          data-stage-title={stage.title}
          aria-controls={`workflow-panel-${index}`}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          <span>{String(index + 1).padStart(2, '0')}</span>
          {stage.label}
        </button>
      ))
    }
  </div>

  <div class="workflow-viewport">
    <section
      class="workflow-panel workflow-panel--plan"
      id="workflow-panel-0"
      aria-labelledby="workflow-stage-0"
      data-workflow-panel
      data-stage-index="0"
    >
      <p class="workflow-kicker" data-workflow-item>Household conversation</p>
      <p class="workflow-request" data-workflow-item>
        Plan five dinners for four. Tuesday is only two of us, Mia won’t eat
        mushrooms, Thursday needs to be quick, and use the spinach first.
      </p>
      <div class="workflow-response" data-workflow-item>
        <span class="workflow-avatar" aria-hidden="true">C</span>
        <span>
          <strong>Creating five dinners for your week</strong>
          <small>Keeping every household decision visible</small>
        </span>
      </div>
      <ul class="workflow-context" aria-label="Household context being used">
        <li data-workflow-item>
          <span>Mia</span><strong>No mushrooms</strong>
        </li>
        <li data-workflow-item>
          <span>Thursday</span><strong>Quick dinner</strong>
        </li>
        <li data-workflow-item>
          <span>Use first</span><strong>Baby spinach</strong>
        </li>
      </ul>
    </section>

    <section
      class="workflow-panel workflow-panel--meals"
      id="workflow-panel-1"
      aria-labelledby="workflow-stage-1"
      data-workflow-panel
      data-stage-index="1"
      hidden
    >
      <div class="workflow-summary" data-workflow-item>
        <strong><i aria-hidden="true"></i>5 dinners set</strong>
        <span>Review before confirming</span>
      </div>
      <div class="workflow-meals" aria-label="Meals set for the week">
        {
          meals.map(([day, meal, meta, tone]) => (
            <div
              class:list={['workflow-meal', tone && `workflow-meal--${tone}`]}
              data-workflow-item
            >
              <span>{day}</span>
              <strong>{meal}</strong>
              <small>{meta}</small>
            </div>
          ))
        }
      </div>
    </section>

    <section
      class="workflow-panel workflow-panel--trolley"
      id="workflow-panel-2"
      aria-labelledby="workflow-stage-2"
      data-workflow-panel
      data-stage-index="2"
      hidden
    >
      <div class="workflow-trolley-heading" data-workflow-item>
        <span>
          <small>Woolworths trolley</small>
          <strong>Ready for review</strong>
        </span>
        <em>24 items</em>
      </div>
      <div class="workflow-progress" aria-hidden="true">
        <span data-workflow-progress></span>
      </div>
      <div class="workflow-trolley-list">
        <div class="workflow-trolley-row" data-workflow-item>
          <i aria-hidden="true">✓</i>
          <span>
            <strong>18 meal ingredients matched</strong>
            <small>Quantities checked against the plan</small>
          </span>
        </div>
        <div class="workflow-trolley-row" data-workflow-item>
          <i aria-hidden="true">✓</i>
          <span>
            <strong>6 household essentials added</strong>
            <small>Milk, fruit, breakfast, and cleaning items</small>
          </span>
        </div>
        <div
          class="workflow-trolley-row workflow-trolley-row--attention"
          data-workflow-item
        >
          <i aria-hidden="true">1</i>
          <span>
            <strong>One substitution needs you</strong>
            <small>Chef paused before making the choice</small>
          </span>
        </div>
      </div>
      <p class="workflow-checkout" data-workflow-item>
        Trolley ready for your review <span>Checkout stays yours</span>
      </p>
    </section>

    <section
      class="workflow-panel workflow-panel--tonight"
      id="workflow-panel-3"
      aria-labelledby="workflow-stage-3"
      data-workflow-panel
      data-stage-index="3"
      hidden
    >
      <div class="workflow-cooking-heading" data-workflow-item>
        <span>
          <small>Tonight · Dinner</small>
          <strong>Spinach &amp; lemon chicken</strong>
        </span>
        <em>Cooking mode</em>
      </div>
      <div class="workflow-cooking-meta" data-workflow-item>
        <span>Step 2 of 5</span>
        <span>4 servings · 30 min</span>
      </div>
      <div
        class="workflow-progress workflow-progress--cooking"
        aria-hidden="true"
      >
        <span data-workflow-progress></span>
      </div>
      <div class="workflow-current-step" data-workflow-item>
        <small>Current step</small>
        <p>
          Add the spinach and lemon, then cook until the spinach has just
          wilted.
        </p>
      </div>
      <div class="workflow-cooking-footer" data-workflow-item>
        <span>
          <small>Timer</small>
          <strong>08:00</strong>
        </span>
        <span class="workflow-next">Next step <i aria-hidden="true">→</i></span>
      </div>
    </section>
  </div>

  <p class="sr-only" data-workflow-status aria-live="polite"></p>
</article>

<script>
  import '../scripts/hero-workflow';
</script>

<style>
  .hero-workflow {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    min-width: 0;
    overflow: hidden;
  }

  .workflow-header {
    align-items: center;
    background: var(--canvas);
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    min-height: 4rem;
    padding-inline: 1.25rem;
  }

  .workflow-identity {
    align-items: center;
    display: flex;
    gap: 0.625rem;
    min-width: 0;
  }

  .workflow-identity > i,
  .workflow-summary i {
    background: var(--paprika);
    border-radius: 50%;
    display: inline-block;
    flex: 0 0 auto;
    height: 0.5rem;
    width: 0.5rem;
  }

  .workflow-identity span,
  .workflow-trolley-heading span,
  .workflow-cooking-heading span {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .workflow-identity small,
  .workflow-trolley-heading small,
  .workflow-cooking-heading small {
    color: var(--muted);
    font-size: 0.6875rem;
    line-height: 1.2;
  }

  .workflow-identity strong {
    font-size: 0.875rem;
    font-weight: 600;
    margin-top: 0.2rem;
  }

  .workflow-playback {
    background: transparent;
    border: 0;
    color: var(--sage-strong);
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 600;
    min-height: 2.75rem;
    padding: 0 0 0 1rem;
  }

  .workflow-stage-controls {
    background: var(--canvas);
    border-bottom: 1px solid var(--border);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding-inline: 0.75rem;
  }

  .workflow-stage-controls button {
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    color: var(--muted);
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 600;
    min-height: 3rem;
    padding: 0.25rem;
  }

  .workflow-stage-controls button span {
    display: block;
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    margin-bottom: 0.125rem;
  }

  .workflow-stage-controls button[aria-pressed='true'] {
    border-bottom-color: var(--paprika);
    color: var(--ink);
  }

  .workflow-viewport {
    min-height: 22.75rem;
    padding: 1.25rem;
  }

  .workflow-panel {
    min-height: 20.25rem;
  }

  .workflow-kicker {
    color: var(--sage-strong);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .workflow-request {
    background: var(--ink);
    border-radius: 1rem 1rem 0.25rem 1rem;
    color: #fff;
    font-size: 0.875rem;
    line-height: 1.5;
    margin-left: auto;
    margin-top: 0.75rem;
    max-width: 29.375rem;
    padding: 0.875rem 1rem;
  }

  .workflow-response {
    align-items: center;
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .workflow-response > span:last-child {
    display: flex;
    flex-direction: column;
  }

  .workflow-avatar {
    align-items: center;
    background: var(--paprika);
    border-radius: 50%;
    color: #fff;
    display: flex;
    flex: 0 0 auto;
    font-size: 0.6875rem;
    font-weight: 700;
    height: 2rem;
    justify-content: center;
    width: 2rem;
  }

  .workflow-response strong {
    font-size: 0.8125rem;
  }

  .workflow-response small {
    color: var(--muted);
    font-size: 0.75rem;
    margin-top: 0.2rem;
  }

  .workflow-context {
    border-bottom: 1px solid var(--border);
    border-top: 1px solid var(--border);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .workflow-context li {
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
    padding: 0.875rem;
  }

  .workflow-context li:last-child {
    border-right: 0;
  }

  .workflow-context span,
  .workflow-context strong {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .workflow-context span {
    color: var(--muted);
    font-size: 0.6875rem;
  }

  .workflow-context strong {
    font-size: 0.75rem;
  }

  .workflow-summary {
    align-items: center;
    display: flex;
    justify-content: space-between;
    min-height: 2.25rem;
    padding-inline: 0.125rem;
  }

  .workflow-summary strong {
    align-items: center;
    color: var(--sage-strong);
    display: flex;
    font-size: 0.8125rem;
    gap: 0.55rem;
  }

  .workflow-summary i {
    background: var(--sage);
  }

  .workflow-summary span {
    color: var(--muted);
    font-size: 0.75rem;
  }

  .workflow-meals {
    background: var(--canvas);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    margin-top: 0.75rem;
    overflow: hidden;
  }

  .workflow-meal {
    align-items: center;
    border-bottom: 1px solid var(--border);
    display: grid;
    gap: 0.5rem;
    grid-template-columns: 4rem 1fr 5.75rem;
    min-height: 3.25rem;
    padding-inline: 0.875rem;
  }

  .workflow-meal:last-child {
    border-bottom: 0;
  }

  .workflow-meal--oat {
    background: rgb(220 207 185 / 28%);
  }

  .workflow-meal--sage {
    background: rgb(111 128 106 / 8%);
  }

  .workflow-meal span,
  .workflow-meal small {
    color: var(--muted);
    font-size: 0.75rem;
  }

  .workflow-meal strong {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .workflow-meal small {
    color: var(--sage-strong);
    text-align: right;
  }

  .workflow-trolley-heading,
  .workflow-cooking-heading {
    align-items: center;
    display: flex;
    justify-content: space-between;
  }

  .workflow-trolley-heading strong,
  .workflow-cooking-heading strong {
    font-size: 1rem;
    margin-top: 0.25rem;
  }

  .workflow-trolley-heading em,
  .workflow-cooking-heading em {
    background: rgb(111 128 106 / 11%);
    border-radius: 999px;
    color: var(--sage-strong);
    font-size: 0.6875rem;
    font-style: normal;
    font-weight: 600;
    padding: 0.35rem 0.625rem;
  }

  .workflow-progress {
    background: rgb(111 128 106 / 14%);
    border-radius: 999px;
    height: 0.25rem;
    margin-top: 1rem;
    overflow: hidden;
  }

  .workflow-progress > span {
    background: var(--sage);
    display: block;
    height: 100%;
    transform: scaleX(1);
    transform-origin: left;
    width: 100%;
  }

  .workflow-trolley-list {
    margin-top: 0.75rem;
  }

  .workflow-trolley-row {
    align-items: center;
    border-bottom: 1px solid var(--border);
    display: flex;
    gap: 0.75rem;
    min-height: 4.25rem;
    padding: 0.625rem 0.25rem;
  }

  .workflow-trolley-row > i {
    align-items: center;
    background: rgb(111 128 106 / 13%);
    border-radius: 50%;
    color: var(--sage-strong);
    display: flex;
    flex: 0 0 auto;
    font-size: 0.75rem;
    font-style: normal;
    font-weight: 700;
    height: 1.75rem;
    justify-content: center;
    width: 1.75rem;
  }

  .workflow-trolley-row > span {
    display: flex;
    flex-direction: column;
  }

  .workflow-trolley-row strong {
    font-size: 0.8125rem;
  }

  .workflow-trolley-row small {
    color: var(--muted);
    font-size: 0.75rem;
    margin-top: 0.2rem;
  }

  .workflow-trolley-row--attention > i {
    background: rgb(201 79 50 / 12%);
    color: var(--paprika);
  }

  .workflow-checkout {
    align-items: center;
    color: var(--muted);
    display: flex;
    font-size: 0.75rem;
    justify-content: space-between;
    margin-top: 0.875rem;
  }

  .workflow-checkout span {
    color: var(--ink);
    font-weight: 600;
  }

  .workflow-cooking-meta {
    color: var(--muted);
    display: flex;
    font-size: 0.75rem;
    justify-content: space-between;
    margin-top: 1.25rem;
  }

  .workflow-progress--cooking > span {
    background: var(--paprika);
    width: 40%;
  }

  .workflow-current-step {
    border-bottom: 1px solid var(--border);
    border-top: 1px solid var(--border);
    margin-top: 1.25rem;
    padding-block: 1.375rem;
  }

  .workflow-current-step small,
  .workflow-cooking-footer small {
    color: var(--muted);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .workflow-current-step p {
    font-family: var(--font-editorial);
    font-size: 1.625rem;
    line-height: 1.25;
    margin-top: 0.55rem;
    max-width: 31rem;
  }

  .workflow-cooking-footer {
    align-items: end;
    display: flex;
    justify-content: space-between;
    margin-top: 1rem;
  }

  .workflow-cooking-footer > span:first-child {
    display: flex;
    flex-direction: column;
  }

  .workflow-cooking-footer strong {
    font-size: 1.125rem;
    font-variant-numeric: tabular-nums;
    margin-top: 0.15rem;
  }

  .workflow-next {
    align-items: center;
    background: var(--paprika);
    border-radius: var(--radius-sm);
    color: #fff;
    display: flex;
    font-size: 0.75rem;
    font-weight: 600;
    gap: 0.45rem;
    min-height: 2.5rem;
    padding-inline: 0.875rem;
  }

  .workflow-next i {
    font-style: normal;
  }

  @media (max-width: 52rem) {
    .hero-workflow {
      align-self: stretch;
      border-left: 0;
      border-radius: 0;
      border-right: 0;
      margin-inline: calc(var(--page-gutter) * -1);
      max-width: none;
      width: calc(100% + (var(--page-gutter) * 2));
    }

    .workflow-header {
      padding-inline: var(--page-gutter);
    }

    .workflow-stage-controls {
      padding-inline: calc(var(--page-gutter) - 0.5rem);
    }

    .workflow-stage-controls button {
      font-size: 0.6875rem;
      min-height: 2.875rem;
    }

    .workflow-viewport {
      min-height: 24rem;
      padding: 1rem var(--page-gutter) 1.25rem;
    }

    .workflow-panel {
      min-height: 21.75rem;
    }

    .workflow-request {
      font-size: 0.8125rem;
      max-width: 20.5rem;
    }

    .workflow-context li {
      padding: 0.75rem 0.5rem;
    }

    .workflow-meal {
      grid-template-columns: 3.125rem 1fr;
      min-height: 4rem;
    }

    .workflow-meal small {
      grid-column: 2;
      text-align: left;
    }

    .workflow-meal:nth-child(n + 4) {
      display: none;
    }

    .workflow-summary span {
      font-size: 0.6875rem;
    }

    .workflow-trolley-row {
      min-height: 4.125rem;
    }

    .workflow-current-step p {
      font-family: var(--font-sans);
      font-size: 1.375rem;
      line-height: 1.35;
    }
  }
</style>
