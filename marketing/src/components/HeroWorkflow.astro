---
const stages = [
  { label: 'Plan', title: 'Plan the week' },
  { label: 'Meals', title: 'Set the meals' },
  { label: 'Trolley', title: 'Prepare the trolley' },
  { label: 'Tonight', title: 'Cook tonight' },
] as const;

const meals = [
  ['MON 20', 'Spinach & lemon chicken', '4 people · 30m', '', false],
  ['TUE 21', 'Tomato gnocchi', '2 people · 25m', 'oat', false],
  ['WED 22', 'Leftover lemon chicken', '4 people · 10m', '', true],
  ['THU 23', 'Mushroom risotto', '4 people · 35m', 'sage', false],
  ['FRI 24', 'Takeaway night', 'Open choice', '', true],
] as const;
---

<article
  class="hero-workflow"
  aria-label="One household plan moving from conversation to tonight’s dinner"
  data-hero-workflow
  data-reveal
>
  <header class="workflow-header">
    <div class="workflow-identity">
      <i aria-hidden="true"></i>
      <span>
        <small>Winter weeknight plan</small>
        <strong data-workflow-current-label>Plan the week</strong>
      </span>
    </div>
    <button
      class="workflow-playback"
      type="button"
      data-workflow-playback
      aria-label="Pause workflow animation"
    >
      Pause
    </button>
  </header>

  <div class="workflow-stage-controls" aria-label="Workflow stages">
    {
      stages.map((stage, index) => (
        <button
          id={`workflow-stage-${index}`}
          type="button"
          data-workflow-control
          data-stage-index={index}
          data-stage-label={stage.label}
          data-stage-title={stage.title}
          aria-controls={`workflow-panel-${index}`}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          <span>{String(index + 1).padStart(2, '0')}</span>
          {stage.label}
        </button>
      ))
    }
  </div>

  <div class="workflow-viewport">
    <section
      class="workflow-panel workflow-panel--plan"
      id="workflow-panel-0"
      aria-labelledby="workflow-stage-0"
      data-workflow-panel
      data-stage-index="0"
    >
      <p class="workflow-kicker" data-workflow-item>Household conversation</p>
      <p class="workflow-request" data-workflow-item>
        Plan five dinners for four. Tuesday is only two of us, Mia won’t eat
        mushrooms, Thursday needs to be quick, and use the spinach first.
      </p>
      <div class="workflow-response" data-plan-thinking hidden>
        <span class="workflow-avatar" aria-hidden="true">C</span>
        <span>
          <strong class="workflow-thinking-label">
            <i class="workflow-spinner" aria-hidden="true"></i>
            Thinking through your week…
          </strong>
          <small>Checking who’s eating and what this week needs</small>
        </span>
      </div>
      <div class="workflow-response" data-plan-response hidden>
        <span class="workflow-avatar" aria-hidden="true">C</span>
        <span>
          <strong>I’ve built five dinners around your household</strong>
          <small>Every decision stays visible and editable</small>
        </span>
      </div>
      <ul
        class="workflow-context"
        aria-label="Household context being used"
        data-plan-context-list
        hidden
      >
        <li data-plan-context data-sequence-visible="false" aria-hidden="true">
          <span>Mia</span><strong>No mushrooms</strong>
        </li>
        <li data-plan-context data-sequence-visible="false" aria-hidden="true">
          <span>Thursday</span><strong>Quick dinner</strong>
        </li>
        <li data-plan-context data-sequence-visible="false" aria-hidden="true">
          <span>Use first</span><strong>Baby spinach</strong>
        </li>
      </ul>
    </section>

    <section
      class="workflow-panel workflow-panel--meals"
      id="workflow-panel-1"
      aria-labelledby="workflow-stage-1"
      data-workflow-panel
      data-stage-index="1"
      hidden
    >
      <div class="workflow-summary">
        <strong
          ><i aria-hidden="true"></i><span data-meals-summary
            >Reviewing five dinners</span
          ></strong
        >
        <span data-meals-summary-detail>Checking household fit</span>
      </div>
      <div class="workflow-meals" aria-label="Meals set for the week">
        {
          meals.map(([day, meal, meta, tone, mobileHidden], index) => (
            <div
              class:list={[
                'workflow-meal',
                tone && `workflow-meal--${tone}`,
                mobileHidden && 'workflow-meal--mobile-hidden',
              ]}
              data-meal-row
              data-meal-index={index}
              data-initial-title={meal}
              data-initial-meta={meta}
              data-final-title={index === 3 ? 'Quick beef rice bowls' : meal}
              data-final-meta={index === 3 ? '4 people · 20m' : meta}
              data-rejected-meta={
                index === 3
                  ? 'Mia dislikes mushrooms · Thursday needs to be quick'
                  : undefined
              }
              data-approved-label="Approved"
              data-rejected-label="Rejected"
              data-replaced-label="Replaced"
              data-sequence-visible="false"
              aria-hidden="true"
            >
              <span>{day}</span>
              <span class="workflow-meal-copy">
                <strong data-meal-title>{meal}</strong>
                <small data-meal-meta>{meta}</small>
              </span>
              <span
                class="workflow-meal-status"
                data-meal-status
                data-state="pending"
              >
                <i aria-hidden="true">
                  <span class="workflow-spinner" />
                </i>
                <span data-meal-status-label>Checking</span>
              </span>
            </div>
          ))
        }
      </div>
    </section>

    <section
      class="workflow-panel workflow-panel--trolley"
      id="workflow-panel-2"
      aria-labelledby="workflow-stage-2"
      data-workflow-panel
      data-stage-index="2"
      hidden
    >
      <div class="workflow-trolley-heading">
        <span>
          <small>Woolworths trolley</small>
          <strong data-trolley-title>Preparing your trolley</strong>
        </span>
        <em data-trolley-count>Matching…</em>
      </div>
      <div class="workflow-progress" aria-hidden="true">
        <span data-workflow-progress></span>
      </div>
      <div class="workflow-trolley-list">
        <div
          class="workflow-trolley-row"
          data-trolley-row
          data-state="matching"
          data-initial-title="Matching meal ingredients"
          data-initial-detail="Checking quantities against the plan"
          data-final-title="18 meal ingredients matched"
          data-final-detail="Quantities checked against the plan"
        >
          <i aria-hidden="true"><span class="workflow-spinner"></span></i>
          <span>
            <strong data-trolley-row-title>Matching meal ingredients</strong>
            <small data-trolley-row-detail
              >Checking quantities against the plan</small
            >
          </span>
        </div>
        <div
          class="workflow-trolley-row"
          data-trolley-row
          data-state="matching"
          data-initial-title="Adding household essentials"
          data-initial-detail="Matching your saved products"
          data-final-title="6 household essentials added"
          data-final-detail="Milk, fruit, breakfast, and cleaning items"
        >
          <i aria-hidden="true"><span class="workflow-spinner"></span></i>
          <span>
            <strong data-trolley-row-title>Adding household essentials</strong>
            <small data-trolley-row-detail>Matching your saved products</small>
          </span>
        </div>
        <div
          class="workflow-trolley-row workflow-trolley-row--attention"
          data-trolley-row
          data-state="matching"
          data-initial-title="Checking substitutions"
          data-initial-detail="Comparing every product match"
          data-final-title="One substitution needs you"
          data-final-detail="Chef paused before making the choice"
        >
          <i aria-hidden="true"><span class="workflow-spinner"></span></i>
          <span>
            <strong data-trolley-row-title>Checking substitutions</strong>
            <small data-trolley-row-detail>Comparing every product match</small>
          </span>
        </div>
      </div>
      <p class="workflow-checkout" data-trolley-checkout hidden>
        Trolley ready for your review <span>Checkout stays yours</span>
      </p>
    </section>

    <section
      class="workflow-panel workflow-panel--tonight"
      id="workflow-panel-3"
      aria-labelledby="workflow-stage-3"
      data-workflow-panel
      data-stage-index="3"
      hidden
    >
      <div class="workflow-cooking-heading" data-workflow-item>
        <span>
          <small>Tonight · Dinner</small>
          <strong>Spinach &amp; lemon chicken</strong>
        </span>
        <em>Cooking mode</em>
      </div>
      <div class="workflow-cooking-meta" data-workflow-item>
        <span data-cooking-step>Step 2 of 5</span>
        <span>4 servings · 30 min</span>
      </div>
      <div
        class="workflow-progress workflow-progress--cooking"
        aria-hidden="true"
      >
        <span data-cooking-progress></span>
      </div>
      <div
        class="workflow-current-step"
        data-workflow-item
        data-cooking-current
        data-state="current"
      >
        <div class="workflow-step-heading">
          <small data-cooking-state>Current step</small>
          <span class="workflow-step-complete" data-cooking-complete hidden>
            <i aria-hidden="true">✓</i> Complete
          </span>
        </div>
        <p
          data-cooking-instruction
          data-step-two="Add the spinach and lemon, then cook until the spinach has just wilted."
          data-step-three="Turn the chicken through the pan sauce and simmer until every piece is coated."
          data-step-four="Divide between bowls, spoon over the pan sauce, and finish with fresh lemon."
        >
          <span data-cooking-instruction-text>
            Add the spinach and lemon, then cook until the spinach has just
            wilted.
          </span>
          <span
            class="workflow-strike-overlay"
            data-cooking-strike
            aria-hidden="true"
          >
            Add the spinach and lemon, then cook until the spinach has just
            wilted.
          </span>
        </p>
      </div>
      <div class="workflow-cooking-footer" data-workflow-item>
        <span>
          <small>Timer</small>
          <strong
            data-workflow-timer
            aria-label="8 minutes remaining"
            aria-live="off">08:00</strong
          >
        </span>
        <span class="workflow-next" data-cooking-action data-state="current">
          <span data-cooking-action-label>Next step</span>
          <i data-cooking-action-icon aria-hidden="true">→</i>
        </span>
      </div>
    </section>
  </div>

  <p class="sr-only" data-workflow-status aria-live="polite"></p>
</article>

<script>
  import '../scripts/hero-workflow';
</script>

<style>
  .hero-workflow {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    min-width: 0;
    overflow: hidden;
  }

  .workflow-header {
    align-items: center;
    background: var(--canvas);
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    min-height: 4rem;
    padding-inline: 1.25rem;
  }

  .workflow-identity {
    align-items: center;
    display: flex;
    gap: 0.625rem;
    min-width: 0;
  }

  .workflow-identity > i,
  .workflow-summary i {
    background: var(--paprika);
    border-radius: 50%;
    display: inline-block;
    flex: 0 0 auto;
    height: 0.5rem;
    width: 0.5rem;
  }

  .workflow-identity span,
  .workflow-trolley-heading span,
  .workflow-cooking-heading span {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .workflow-identity small,
  .workflow-trolley-heading small,
  .workflow-cooking-heading small {
    color: var(--muted);
    font-size: 0.6875rem;
    line-height: 1.2;
  }

  .workflow-identity strong {
    font-size: 0.875rem;
    font-weight: 600;
    margin-top: 0.2rem;
  }

  .workflow-playback {
    background: transparent;
    border: 0;
    color: var(--sage-strong);
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 600;
    min-height: 2.75rem;
    padding: 0 0 0 1rem;
  }

  .workflow-stage-controls {
    background: var(--canvas);
    border-bottom: 1px solid var(--border);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding-inline: 0.75rem;
  }

  .workflow-stage-controls button {
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    color: var(--muted);
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 600;
    min-height: 3rem;
    padding: 0.25rem;
  }

  .workflow-stage-controls button span {
    display: block;
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    margin-bottom: 0.125rem;
  }

  .workflow-stage-controls button[aria-pressed='true'] {
    border-bottom-color: var(--paprika);
    color: var(--ink);
  }

  .workflow-viewport {
    min-height: 22.75rem;
    padding: 1.25rem;
  }

  .workflow-panel {
    min-height: 20.25rem;
  }

  .workflow-kicker {
    color: var(--sage-strong);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .workflow-request {
    background: var(--ink);
    border-radius: 1rem 1rem 0.25rem 1rem;
    color: #fff;
    font-size: 0.875rem;
    line-height: 1.5;
    margin-left: auto;
    margin-top: 0.75rem;
    max-width: 29.375rem;
    padding: 0.875rem 1rem;
  }

  .workflow-response {
    align-items: center;
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .workflow-response[hidden],
  .workflow-context[hidden],
  .workflow-checkout[hidden],
  .workflow-step-complete[hidden] {
    display: none;
  }

  .workflow-response > span:last-child {
    display: flex;
    flex-direction: column;
  }

  .workflow-avatar {
    align-items: center;
    background: var(--paprika);
    border-radius: 50%;
    color: #fff;
    display: flex;
    flex: 0 0 auto;
    font-size: 0.6875rem;
    font-weight: 700;
    height: 2rem;
    justify-content: center;
    width: 2rem;
  }

  .workflow-response strong {
    font-size: 0.8125rem;
  }

  .workflow-thinking-label {
    align-items: center;
    display: flex;
    gap: 0.5rem;
  }

  .workflow-spinner {
    animation: workflow-spin 0.85s linear infinite;
    border: 2px solid rgb(111 128 106 / 22%);
    border-radius: 50%;
    border-top-color: var(--sage-strong);
    display: inline-block;
    flex: 0 0 auto;
    height: 0.875rem;
    width: 0.875rem;
  }

  .hero-workflow[data-workflow-paused='true'] .workflow-spinner {
    animation-play-state: paused;
  }

  [data-sequence-visible='false'] {
    opacity: 0;
    transform: translateY(8px);
    visibility: hidden;
  }

  .workflow-response small {
    color: var(--muted);
    font-size: 0.75rem;
    margin-top: 0.2rem;
  }

  .workflow-context {
    border-bottom: 1px solid var(--border);
    border-top: 1px solid var(--border);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .workflow-context li {
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
    padding: 0.875rem;
  }

  .workflow-context li:last-child {
    border-right: 0;
  }

  .workflow-context span,
  .workflow-context strong {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .workflow-context span {
    color: var(--muted);
    font-size: 0.6875rem;
  }

  .workflow-context strong {
    font-size: 0.75rem;
  }

  .workflow-summary {
    align-items: center;
    display: flex;
    justify-content: space-between;
    min-height: 2.25rem;
    padding-inline: 0.125rem;
  }

  .workflow-summary strong {
    align-items: center;
    color: var(--sage-strong);
    display: flex;
    font-size: 0.8125rem;
    gap: 0.55rem;
  }

  .workflow-summary i {
    background: var(--sage);
  }

  .workflow-summary span {
    color: var(--muted);
    font-size: 0.75rem;
  }

  .workflow-meals {
    background: var(--canvas);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    margin-top: 0.75rem;
    overflow: hidden;
  }

  .workflow-meal {
    align-items: center;
    border-bottom: 1px solid var(--border);
    display: grid;
    gap: 0.5rem;
    grid-template-columns: 3.75rem minmax(0, 1fr) auto;
    min-height: 3.25rem;
    padding-inline: 0.875rem;
  }

  .workflow-meal:last-child {
    border-bottom: 0;
  }

  .workflow-meal--oat {
    background: rgb(220 207 185 / 28%);
  }

  .workflow-meal--sage {
    background: rgb(111 128 106 / 8%);
  }

  .workflow-meal > span:first-child,
  .workflow-meal-copy small {
    color: var(--muted);
    font-size: 0.75rem;
  }

  .workflow-meal-copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .workflow-meal-copy strong {
    font-size: 0.875rem;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .workflow-meal-copy small {
    line-height: 1.2;
    margin-top: 0.1rem;
  }

  .workflow-meal-status {
    align-items: center;
    color: var(--muted);
    display: flex;
    font-size: 0.6875rem;
    font-weight: 600;
    gap: 0.35rem;
    justify-content: flex-end;
    min-width: 4.75rem;
  }

  .workflow-meal-status > i {
    align-items: center;
    display: flex;
    font-size: 0.75rem;
    font-style: normal;
    height: 1rem;
    justify-content: center;
    width: 1rem;
  }

  .workflow-meal-status[data-state='accepted'] {
    color: var(--sage-strong);
  }

  .workflow-meal-status[data-state='rejected'] {
    color: var(--paprika);
  }

  .workflow-meal-status[data-state='replaced'] {
    color: var(--ink);
  }

  .workflow-meal-status[data-state='accepted'] > i::before {
    content: '✓';
  }

  .workflow-meal-status[data-state='rejected'] > i::before {
    content: '×';
  }

  .workflow-meal-status[data-state='replaced'] > i::before {
    content: '↻';
  }

  .workflow-meal-status:not([data-state='pending']) .workflow-spinner {
    display: none;
  }

  .workflow-trolley-heading,
  .workflow-cooking-heading {
    align-items: center;
    display: flex;
    justify-content: space-between;
  }

  .workflow-trolley-heading strong,
  .workflow-cooking-heading strong {
    font-size: 1rem;
    margin-top: 0.25rem;
  }

  .workflow-trolley-heading em,
  .workflow-cooking-heading em {
    background: rgb(111 128 106 / 11%);
    border-radius: 999px;
    color: var(--sage-strong);
    font-size: 0.6875rem;
    font-style: normal;
    font-weight: 600;
    padding: 0.35rem 0.625rem;
  }

  .workflow-progress {
    background: rgb(111 128 106 / 14%);
    border-radius: 999px;
    height: 0.25rem;
    margin-top: 1rem;
    overflow: hidden;
  }

  .workflow-progress > span {
    background: var(--sage);
    display: block;
    height: 100%;
    transform: scaleX(0);
    transform-origin: left;
    width: 100%;
  }

  .workflow-trolley-list {
    margin-top: 0.75rem;
  }

  .workflow-trolley-row {
    align-items: center;
    border-bottom: 1px solid var(--border);
    display: flex;
    gap: 0.75rem;
    min-height: 4.25rem;
    padding: 0.625rem 0.25rem;
  }

  .workflow-trolley-row > i {
    align-items: center;
    background: rgb(111 128 106 / 13%);
    border-radius: 50%;
    color: var(--sage-strong);
    display: flex;
    flex: 0 0 auto;
    font-size: 0.75rem;
    font-style: normal;
    font-weight: 700;
    height: 1.75rem;
    justify-content: center;
    width: 1.75rem;
  }

  .workflow-trolley-row > i::before {
    display: none;
  }

  .workflow-trolley-row[data-state='complete'] > i::before {
    content: '✓';
    display: block;
  }

  .workflow-trolley-row[data-state='attention'] > i::before {
    content: '1';
    display: block;
  }

  .workflow-trolley-row:not([data-state='matching']) > i .workflow-spinner {
    display: none;
  }

  .workflow-trolley-row > span {
    display: flex;
    flex-direction: column;
  }

  .workflow-trolley-row strong {
    font-size: 0.8125rem;
  }

  .workflow-trolley-row small {
    color: var(--muted);
    font-size: 0.75rem;
    margin-top: 0.2rem;
  }

  .workflow-trolley-row--attention > i {
    background: rgb(111 128 106 / 13%);
    color: var(--sage-strong);
  }

  .workflow-trolley-row--attention[data-state='attention'] > i {
    background: rgb(201 79 50 / 12%);
    color: var(--paprika);
  }

  .workflow-checkout {
    align-items: center;
    color: var(--muted);
    display: flex;
    font-size: 0.75rem;
    justify-content: space-between;
    margin-top: 0.875rem;
  }

  .workflow-checkout span {
    color: var(--ink);
    font-weight: 600;
  }

  .workflow-cooking-meta {
    color: var(--muted);
    display: flex;
    font-size: 0.75rem;
    justify-content: space-between;
    margin-top: 1.25rem;
  }

  .workflow-progress--cooking > span {
    background: var(--paprika);
    transform: scaleX(0.4);
    width: 100%;
  }

  .workflow-current-step {
    border-bottom: 1px solid var(--border);
    border-top: 1px solid var(--border);
    margin-top: 1.25rem;
    padding-block: 1.375rem;
  }

  .workflow-step-heading {
    align-items: center;
    display: flex;
    justify-content: space-between;
  }

  .workflow-step-complete {
    align-items: center;
    color: var(--sage-strong);
    display: flex;
    font-size: 0.6875rem;
    font-weight: 600;
    gap: 0.35rem;
  }

  .workflow-step-complete i {
    align-items: center;
    background: rgb(111 128 106 / 13%);
    border-radius: 50%;
    display: flex;
    font-size: 0.625rem;
    font-style: normal;
    height: 1.25rem;
    justify-content: center;
    width: 1.25rem;
  }

  .workflow-current-step small,
  .workflow-cooking-footer small {
