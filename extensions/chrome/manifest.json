{
  "manifest_version": 3,
  "name": "Chef retailer handoff",
  "description": "Executes Chef-validated actions in one selected Woolworths or Coles tab.",
  "version": "0.1.0",
  "homepage_url": "http://localhost:8000",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "alarms", "scripting", "storage"],
  "host_permissions": [
    "https://www.woolworths.com.au/*",
    "https://www.coles.com.au/*",
    "http://localhost/*",
    "https://app.chef.example/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Chef retailer handoff",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
