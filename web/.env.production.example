APP_NAME=Chef
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://chef.example.com
APP_RELEASE=git-sha-or-version
APP_TIMEZONE=Australia/Melbourne
RELEASE_EVIDENCE_KEY=

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

LOG_CHANNEL=stack
LOG_STACK=stderr,nightwatch
LOG_LEVEL=info
NIGHTWATCH_TOKEN=
NIGHTWATCH_CAPTURE_REQUEST_PAYLOAD=false
NIGHTWATCH_REQUEST_SAMPLE_RATE=0.1

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_URL=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=postmark
POSTMARK_API_KEY=
MAIL_FROM_ADDRESS=support@chef.example.com
MAIL_FROM_NAME="${APP_NAME}"

OPENAI_API_KEY=
OPENAI_STORE=false
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_TIMEOUT=30
OPENAI_COMPUTER_MODEL=gpt-5.6
OPENAI_COMPUTER_TIMEOUT=90

AUTOMATION_SCREENSHOT_RETENTION_HOURS=24
AUTOMATION_SCREENSHOT_DISK=s3
AUTOMATION_RUN_EXPIRY_MINUTES=60
CONVERSATION_RETENTION_DAYS=730
AUDIT_RETENTION_DAYS=730
AI_REQUESTS_PER_MINUTE=12
AI_TOKENS_PER_MONTH=2000000
AI_COST_USD_PER_MONTH=25
# Replace zeroes with the provider rates approved on the release date.
AI_INPUT_USD_PER_MILLION=0
AI_OUTPUT_USD_PER_MILLION=0
AI_CACHE_READ_USD_PER_MILLION=0
AUTOMATION_RUNS_PER_DAY=10
AUTOMATION_STEPS_PER_RUN=100
VOICE_SESSIONS_PER_DAY=20

SUPPORT_EMAIL=support@chef.example.com
PRIVACY_URL=https://chef.example.com/privacy
TERMS_URL=https://chef.example.com/terms
LEGAL_ENTITY_NAME="Replace with operating legal entity"
LEGAL_CONTACT_ADDRESS="Replace with postal contact address"
DATA_PROCESSING_COUNTRIES="Australia and the countries listed by approved subprocessors"

VITE_APP_NAME="${APP_NAME}"
