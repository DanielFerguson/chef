APP_NAME=Chef
APP_TIMEZONE=Australia/Melbourne
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
IMAGE_DRIVER=gd
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=360
BEANSTALKD_QUEUE_RETRY_AFTER=360
REDIS_QUEUE_RETRY_AFTER=360

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

OPENAI_API_KEY=
OPENAI_CONVERSATION_MODEL=gpt-5.6-luna
OPENAI_RECIPE_BATCH_MODEL=gpt-5.6-sol
OPENAI_RECIPE_BATCH_REASONING_EFFORT=high
OPENAI_RETAILER_SELECTION_MODEL=gpt-5.6-luna
OPENAI_RETAILER_SELECTION_REASONING_EFFORT=medium
OPENAI_RETAILER_RECOVERY_MODEL=gpt-5.6-luna
OPENAI_RETAILER_RECOVERY_REASONING_EFFORT=low
OPENAI_RETAILER_ADJUSTMENT_MODEL=gpt-5.6-sol
OPENAI_RETAILER_ADJUSTMENT_REASONING_EFFORT=medium
OPENAI_STORE=false

# Coles basket beta remains disabled until legal/privacy approval and a live pilot.
CHEF_RETAILER_EXPERIENCE_ENABLED=false
CHEF_RETAILER_DISCOVERY_ENABLED=false
CHEF_RETAILER_MUTATION_ENABLED=false
CHEF_RETAILER_MUTATION_CIRCUIT_BREAKER=true
CHEF_RETAILER_AI_RECOVERY_ENABLED=false
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_REGION=ap-southeast-1
BROWSERBASE_PROXY_COUNTRY=AU
BROWSERBASE_SESSION_TIMEOUT_SECONDS=300
RETAILER_WORKER_NODE_BINARY=node
RETAILER_WORKER_TIMEOUT_SECONDS=120
RETAILER_RUNTIME_CIRCUIT_BREAKER_STORE=redis
RETAILER_RUNTIME_CIRCUIT_BREAKER_KEY=chef:retailer:mutation-circuit-breaker
RETAILER_READINESS_CACHE_STORE=redis
RETAILER_QUEUE_PROBE_TIMEOUT_SECONDS=5

PEST_EVALS_LARAVEL_SCORING_PROVIDER=openai
PEST_EVALS_LARAVEL_SCORING_MODEL=gpt-5.4-nano
VITE_APP_NAME="${APP_NAME}"
