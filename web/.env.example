APP_NAME=Chef
APP_TIMEZONE=Australia/Melbourne
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_RELEASE=development

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

OPENAI_API_KEY=
OPENAI_STORE=false
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_TIMEOUT=30
OPENAI_COMPUTER_MODEL=gpt-5.6
OPENAI_COMPUTER_TIMEOUT=90
AUTOMATION_SCREENSHOT_RETENTION_HOURS=24
AUTOMATION_SCREENSHOT_DISK=local
AUTOMATION_RUN_EXPIRY_MINUTES=60
CONVERSATION_RETENTION_DAYS=730
AUDIT_RETENTION_DAYS=730
AI_REQUESTS_PER_MINUTE=12
AI_TOKENS_PER_MONTH=2000000
AI_COST_USD_PER_MONTH=25
# Set these to the approved provider pricing before each release.
AI_INPUT_USD_PER_MILLION=0
AI_OUTPUT_USD_PER_MILLION=0
AI_CACHE_READ_USD_PER_MILLION=0
AUTOMATION_RUNS_PER_DAY=10
AUTOMATION_STEPS_PER_RUN=100
VOICE_SESSIONS_PER_DAY=20

NIGHTWATCH_TOKEN=
NIGHTWATCH_CAPTURE_REQUEST_PAYLOAD=false
SUPPORT_EMAIL=
PRIVACY_URL=
TERMS_URL=
LEGAL_ENTITY_NAME=
LEGAL_CONTACT_ADDRESS=
DATA_PROCESSING_COUNTRIES=

VITE_APP_NAME="${APP_NAME}"
