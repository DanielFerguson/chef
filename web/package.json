{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && npm run automation:build",
        "build:ssr": "vite build && vite build --ssr",
        "automation:build": "tsc --project automation/tsconfig.json",
        "automation:audit": "npm audit --omit=dev --omit=optional --audit-level=moderate",
        "automation:runtime:prepare": "node automation/scripts/prepare-production-runtime.mjs",
        "automation:test": "npm run automation:build && node --test automation/tests/*.test.mjs",
        "browser:install": "playwright install chromium webkit",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "types:check": "tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^22.13.5",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.3",
        "eslint-plugin-react-hooks": "^7.0.0",
        "playwright": "^1.61.1",
        "prettier": "^3.4.2",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "shadcn": "^4.13.0",
        "typescript-eslint": "^8.23.0"
    },
    "dependencies": {
        "@ai-sdk/openai": "^2.0.117",
        "@base-ui/react": "^1.6.0",
        "@browserbasehq/sdk": "^2.16.0",
        "@browserbasehq/stagehand": "^3.7.1",
        "@fontsource-variable/geist": "^5.2.9",
        "@fontsource/newsreader": "^5.2.10",
        "@fontsource/source-sans-3": "^5.2.9",
        "@inertiajs/react": "^3.0.0",
        "@inertiajs/vite": "^3.0.0",
        "@laravel/passkeys": "^0.2.0",
        "@radix-ui/react-avatar": "^1.1.3",
        "@radix-ui/react-collapsible": "^1.1.3",
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-dropdown-menu": "^2.1.6",
        "@radix-ui/react-label": "^2.1.2",
        "@radix-ui/react-navigation-menu": "^1.2.5",
        "@radix-ui/react-select": "^2.1.6",
        "@radix-ui/react-separator": "^1.1.2",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-toggle": "^1.1.2",
        "@radix-ui/react-toggle-group": "^1.1.2",
        "@radix-ui/react-tooltip": "^1.1.8",
        "@shadcn/react": "^0.3.0",
        "@tailwindcss/vite": "^4.1.11",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^5.2.0",
        "chrome-launcher": "^1.2.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^9.0.1",
        "globals": "^15.14.0",
        "heic-to": "^1.5.2",
        "input-otp": "^1.4.2",
        "laravel-vite-plugin": "^3.0.0",
