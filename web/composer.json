{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/react-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-gd": "*",
        "ext-imagick": "*",
        "inertiajs/inertia-laravel": "^3.0",
        "intervention/image": "^4.0",
        "laravel/ai": "^0.10.3",
        "laravel/chisel": "^0.1.0",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.24",
        "laravel/sanctum": "^4.2",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.4",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-agent": "^5.0",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-drift": "^5.0",
        "pestphp/pest-plugin-evals": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run browser:install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "npm run lint:check",
            "npm run format:check",
            "npm run types:check",
            "@test:full"
        ],
        "types:check": [
            "phpstan analyse"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "@php scripts/pest-tia.php"
        ],
        "test:full": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "pest --ci --no-tia"
        ],
        "test:tia:fresh": [
            "@php scripts/pest-tia.php --tia --fresh"
        ],
        "test:browser": [
            "@php scripts/pest-tia.php tests/Browser"
        ],
        "test:browser:ci": [
            "pest tests/Browser --ci --no-tia"
        ],
        "test:browser:happy": [
            "pest tests/Browser --group=happy-path --browser chrome --ci --no-tia"
        ],
        "test:browser:happy:safari": [
            "pest tests/Browser --group=happy-path --browser safari --ci --no-tia"
        ],
        "test:integration:ci": [
            "pest tests/Integration --ci --no-tia"
        ],
        "test:mutation:critical": [
            "@php scripts/prepare-pest-mutation-runtime.php",
            "php -d pcov.enabled=1 -d pcov.directory=app ./vendor/bin/pest tests/Feature --mutate --class='App\\Actions\\Baskets\\ReplaceBasket,App\\Actions\\Retailers\\SelectRetailerProducts,App\\Actions\\MealPlans\\ApproveMealPlan' --covered-only --min=80 --ci --no-tia"
        ],
        "test:coverage": [
            "php -d pcov.enabled=1 -d pcov.directory=app ./vendor/bin/pest --coverage --min=80 --ci --no-tia"
        ],
        "test:evals": [
            "pest tests/Evals --evals --ci --no-tia"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": []
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
