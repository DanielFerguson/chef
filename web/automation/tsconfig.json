{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "allowJs": false,
        "declaration": false,
        "lib": ["ES2023", "DOM"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "noEmit": false,
        "noEmitOnError": true,
        "outDir": "dist",
        "rootDir": "src",
        "sourceMap": false,
        "types": ["node"]
    },
    "include": ["src/**/*.ts"]
}
